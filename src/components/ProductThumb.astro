---
interface Props {
  hue: number;
  category: string;
  variant?: 'default' | 'tall';
  class?: string;
}

const { hue, category, variant = 'default', class: className = '' } = Astro.props;

const baseDark = `hsl(${hue} 48% 24%)`;
const baseMid = `hsl(${hue} 42% 34%)`;
const baseLight = `hsl(${hue} 38% 46%)`;
const highlight = `hsl(${hue} 60% 72%)`;
const line = `hsl(${hue} 55% 16%)`;
const uid = `${hue}-${category}`;
---

<div class={`relative overflow-hidden ${className}`} style={`background: linear-gradient(145deg, ${baseDark}, ${baseMid});`}>
  <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 h-full w-full" aria-hidden="true">
    <defs>
      <filter id={`grain-${uid}`}>
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch" />
        <feColorMatrix type="saturate" values="0.25" />
      </filter>
      <linearGradient id={`sheen-${uid}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color={highlight} stop-opacity="0.4" />
        <stop offset="50%" stop-color={highlight} stop-opacity="0" />
        <stop offset="100%" stop-color={line} stop-opacity="0.3" />
      </linearGradient>
      <radialGradient id={`glow-${uid}`} cx="0.3" cy="0.25" r="0.7">
        <stop offset="0%" stop-color={highlight} stop-opacity="0.3" />
        <stop offset="100%" stop-color={highlight} stop-opacity="0" />
      </radialGradient>
    </defs>

    <rect x="0" y="0" width="400" height="300" fill={baseDark} />
    <rect x="0" y="0" width="400" height="300" fill={`url(#glow-${uid})`} />
    <rect x="0" y="0" width="400" height="300" fill={`url(#sheen-${uid})`} />

    {/* Wood grain lines */}
    {Array.from({ length: 22 }).map((_, i) => (
      <path
        d={`M ${-15 + i * 19} -15 C ${-15 + i * 19 + 10} 90, ${-15 + i * 19 - 8} 210, ${-15 + i * 19 + 4} 315`}
        stroke={line}
        stroke-opacity={0.10 + (i % 4) * 0.04}
        stroke-width={i % 5 === 0 ? 2.4 : 1.1}
        fill="none"
      />
    ))}

    {/* Category-specific composition */}
    <g opacity="0.92">
      {category === 'tablas' && (
        <g>
          <rect x="90" y="70" width="220" height="160" rx="14" fill={baseLight} opacity="0.88" />
          <rect x="104" y="84" width="192" height="132" rx="9" fill="none" stroke={line} stroke-width="2" opacity="0.35" />
          <rect x="120" y="100" width="160" height="100" rx="5" fill="none" stroke={highlight} stroke-width="1.2" opacity="0.25" />
          <circle cx="200" cy="150" r="6" fill={line} opacity="0.4" />
        </g>
      )}

      {category === 'decoracion' && (
        <g>
          <circle cx="200" cy="150" r="85" fill="none" stroke={highlight} stroke-width="2.5" opacity="0.65" />
          <circle cx="200" cy="150" r="60" fill="none" stroke={highlight} stroke-width="1.8" opacity="0.45" />
          <circle cx="200" cy="150" r="35" fill="none" stroke={highlight} stroke-width="1.2" opacity="0.3" />
          <circle cx="200" cy="150" r="14" fill={highlight} opacity="0.4" />
          <path d="M 200 65 L 200 235 M 115 150 L 285 150" stroke={highlight} stroke-width="1" opacity="0.25" />
        </g>
      )}

      {category === 'muebles' && (
        <g>
          <rect x="100" y="110" width="200" height="22" rx="4" fill={baseLight} />
          <rect x="120" y="132" width="10" height="78" rx="2" fill={line} opacity="0.75" />
          <rect x="270" y="132" width="10" height="78" rx="2" fill={line} opacity="0.75" />
          <rect x="110" y="105" width="180" height="4" rx="2" fill={highlight} opacity="0.5" />
        </g>
      )}

      {category === 'letreros' && (
        <g>
          <rect x="70" y="120" width="260" height="56" rx="6" fill={baseLight} opacity="0.85" />
          <rect x="82" y="132" width="236" height="32" rx="3" fill="none" stroke={line} stroke-width="1.5" opacity="0.3" />
          <text x="200" y="155" text-anchor="middle" font-family="serif" font-size="20" font-weight="600" fill={line} opacity="0.5">Lignare</text>
        </g>
      )}

      {category === 'organizadores' && (
        <g>
          <rect x="110" y="80" width="80" height="80" rx="6" fill={baseLight} opacity="0.82" />
          <rect x="210" y="80" width="80" height="80" rx="6" fill={baseLight} opacity="0.6" />
          <rect x="160" y="170" width="80" height="80" rx="6" fill={baseLight} opacity="0.72" />
          <rect x="120" y="90" width="60" height="60" rx="3" fill="none" stroke={line} stroke-width="1.2" opacity="0.3" />
          <rect x="220" y="90" width="60" height="60" rx="3" fill="none" stroke={line} stroke-width="1.2" opacity="0.25" />
        </g>
      )}

      {category === 'personalizado' && (
        <g>
          <path d="M 140 200 L 200 90 L 260 200 Z" fill={baseLight} opacity="0.8" />
          <path d="M 170 200 L 200 140 L 230 200 Z" fill="none" stroke={highlight} stroke-width="1.5" opacity="0.5" />
          <circle cx="200" cy="172" r="14" fill={highlight} opacity="0.6" />
          <circle cx="200" cy="172" r="5" fill={line} opacity="0.5" />
        </g>
      )}
    </g>

    <rect x="0" y="0" width="400" height="300" filter={`url(#grain-${uid})`} opacity="0.1" />
  </svg>
  <div class="absolute inset-0 wood-grain opacity-25 mix-blend-overlay"></div>
  <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/30 to-transparent"></div>
</div>
