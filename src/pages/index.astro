---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductThumb from '../components/ProductThumb.astro';
import { products, categories } from '../data/products';
import {
  Hammer, Phone, Mail, MapPin, Cpu, Ruler, Leaf, Clock,
  ArrowRight, Star, Check, TreePine, Layers, Boxes, Signpost,
  Sparkles, PenTool, ShieldCheck, Quote, ChevronRight, Menu,
} from 'lucide-react';

const stats = [
  { value: '12+', label: 'Años de oficio' },
  { value: '500+', label: 'Proyectos entregados' },
  { value: '100%', label: 'Madera natural' },
  { value: '48h', label: 'Respuesta de presupuesto' },
];

const categoryIcons: Record<string, typeof Hammer> = {
  tablas: Layers,
  decoracion: Sparkles,
  muebles: Boxes,
  letreros: Signpost,
  organizadores: Boxes,
  personalizado: PenTool,
};

const process = [
  { icon: Mail, title: 'Cuéntanos tu idea', text: 'Escríbenos con tu concepto, medidas o boceto. Te orientamos sin compromiso.' },
  { icon: Cpu, title: 'Diseño y mecanizado', text: 'Modelamos la pieza en CAD y la fresamos con precisión CNC en madera maciza.' },
  { icon: Leaf, title: 'Acabado a mano', text: 'Lijado, aceites y ceras naturales para realzar la veta y proteger la madera.' },
  { icon: Hammer, title: 'Entrega', text: 'Embalaje cuidado y entrega local o envío nacional. Lista para disfrutar.' },
];

const capabilities = [
  { icon: Cpu, title: 'Fresado CNC de alta resolución', text: 'Grabado y corte con tolerancias de décimas de milímetro.' },
  { icon: Layers, title: 'Capas y relieves', text: 'Composiciones tridimensionales en contrachapado y madera maciza.' },
  { icon: ShieldCheck, title: 'Acabados alimentarios', text: 'Aceites y ceras ecológicas, seguros para cocina y contacto directo.' },
  { icon: TreePine, title: 'Maderas locales', text: 'Roble, nogal, olivo, abeto y haya de proveedores sostenibles.' },
  { icon: Ruler, title: 'Prototipos y series', text: 'Desde una pieza única hasta pequeñas series reproducibles.' },
  { icon: PenTool, title: 'Personalización total', text: 'Trabajamos a partir de tu boceto, logo o idea conceptual.' },
];

const testimonials = [
  { name: 'María González', role: 'Diseñadora de interiores', text: 'El relieve topográfico que encargué para el estudio supera las fotos. Calidad y trato impecables.' },
  { name: 'Carlos Ruiz', role: 'Restaurante La Tabla', text: 'Pedimos 20 tablas de corte personalizadas con el logo. Todas idénticas, perfectas para la sala.' },
  { name: 'Lucía Fernández', role: 'Regalo de empresa', text: 'Necesitaba 50 letreros corporativos en una semana. Entregaron a tiempo y con un acabado precioso.' },
];

const featured = products.find((p) => p.id === 'p2')!;
const featured2 = products.find((p) => p.id === 'p5')!;
---

<Layout title="Lignare — Trabajos CNC en madera a medida">
  <!-- Header -->
  <header id="site-header" class="fixed top-0 z-50 w-full border-b border-transparent transition-all duration-300">
    <nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-8">
      <a href="#" class="flex items-center gap-2.5 transition-transform hover:scale-[1.02]">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary text-primary-foreground shadow-soft">
          <Hammer className="h-5 w-5" strokeWidth={2.2} />
        </span>
        <span class="font-display text-xl font-semibold tracking-tight">Lignare</span>
      </a>
      <div class="hidden items-center gap-8 lg:flex">
        <a href="#catalogo" class="nav-link">Catálogo</a>
        <a href="#categorias" class="nav-link">Categorías</a>
        <a href="#proceso" class="nav-link">Proceso</a>
        <a href="#taller" class="nav-link">Taller</a>
        <a href="#opiniones" class="nav-link">Opiniones</a>
        <a href="#contacto" class="nav-link">Contacto</a>
      </div>
      <div class="flex items-center gap-3">
        <a href="#contacto" class="btn-primary hidden sm:inline-flex">
          Pedir presupuesto
          <ArrowRight className="h-4 w-4" />
        </a>
        <button id="menu-toggle" class="flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-card lg:hidden" aria-label="Abrir menú">
          <Menu className="h-5 w-5" />
        </button>
      </div>
    </nav>
    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden border-b border-border bg-background/95 backdrop-blur-md lg:hidden">
      <div class="flex flex-col gap-1 px-5 py-4">
        <a href="#catalogo" class="rounded-lg px-4 py-3 text-sm font-medium text-muted-foreground hover:bg-secondary hover:text-foreground">Catálogo</a>
        <a href="#categorias" class="rounded-lg px-4 py-3 text-sm font-medium text-muted-foreground hover:bg-secondary hover:text-foreground">Categorías</a>
        <a href="#proceso" class="rounded-lg px-4 py-3 text-sm font-medium text-muted-foreground hover:bg-secondary hover:text-foreground">Proceso</a>
        <a href="#taller" class="rounded-lg px-4 py-3 text-sm font-medium text-muted-foreground hover:bg-secondary hover:text-foreground">Taller</a>
        <a href="#opiniones" class="rounded-lg px-4 py-3 text-sm font-medium text-muted-foreground hover:bg-secondary hover:text-foreground">Opiniones</a>
        <a href="#contacto" class="btn-primary mt-2 w-full">Pedir presupuesto</a>
      </div>
    </div>
  </header>

  <!-- Hero -->
  <section class="relative overflow-hidden pt-28 lg:pt-36">
    <div class="absolute inset-0 wood-grain opacity-30"></div>
    <div class="absolute -right-32 -top-20 h-96 w-96 rounded-full bg-accent/15 blur-[120px]"></div>
    <div class="absolute -bottom-32 -left-20 h-96 w-96 rounded-full bg-primary/12 blur-[120px]"></div>

    <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-5 pb-20 lg:grid-cols-[1.1fr_1fr] lg:gap-16 lg:px-8 lg:pb-28">
      <div class="animate-fade-up">
        <span class="chip border border-border bg-card/80 text-muted-foreground backdrop-blur-sm">
          <Cpu className="h-3.5 w-3.5 text-accent" />
          CNC de precisión · Carpintería artesanal
        </span>
        <h1 class="mt-6 font-display text-[2.5rem] font-semibold leading-[1.05] tracking-tight text-balance sm:text-5xl lg:text-[3.75rem]">
          Madera maquinada con
          <span class="relative whitespace-nowrap text-accent">
            precisión
            <svg class="absolute -bottom-1 left-0 h-2.5 w-full text-accent/40" viewBox="0 0 200 10" preserveAspectRatio="none" aria-hidden="true">
              <path d="M0 7 Q 50 0, 100 5 T 200 4" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" />
            </svg>
          </span>
          y oficio.
        </h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-muted-foreground text-pretty sm:text-lg">
          Fabricamos tablas, decoración, muebles y letreros en madera natural con fresado CNC.
          Explora el catálogo y pídenos tu proyecto a medida, sin registro y sin pago online.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#catalogo" class="btn-primary">
            Ver catálogo
            <ArrowRight className="h-4 w-4" />
          </a>
          <a href="#contacto" class="btn-outline">
            Proyecto a medida
          </a>
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-muted-foreground">
          <span class="inline-flex items-center gap-2"><Check className="h-4 w-4 text-success" /> Sin registro</span>
          <span class="inline-flex items-center gap-2"><Check className="h-4 w-4 text-success" /> Presupuesto en 48h</span>
          <span class="inline-flex items-center gap-2"><Check className="h-4 w-4 text-success" /> Maderas sostenibles</span>
        </div>
      </div>

      <!-- Hero composition: stacked product visuals -->
      <div class="relative animate-scale-in">
        <div class="relative grid grid-cols-2 gap-4">
          <div class="space-y-4">
            <div class="overflow-hidden rounded-2xl border border-border shadow-lift">
              <ProductThumb hue={featured.hue} category={featured.category} class="aspect-[3/4] w-full" />
            </div>
            <div class="overflow-hidden rounded-2xl border border-border shadow-soft">
              <ProductThumb hue={30} category="tablas" class="aspect-square w-full" />
            </div>
          </div>
          <div class="space-y-4 pt-10">
            <div class="overflow-hidden rounded-2xl border border-border shadow-soft">
              <ProductThumb hue={featured2.hue} category={featured2.category} class="aspect-square w-full" />
            </div>
            <div class="overflow-hidden rounded-2xl border border-border shadow-lift">
              <ProductThumb hue={24} category="organizadores" class="aspect-[3/4] w-full" />
            </div>
          </div>
        </div>

        <!-- Floating badge -->
        <div class="absolute -left-4 top-1/2 -translate-y-1/2 rounded-xl border border-border bg-card/95 p-3.5 shadow-lift backdrop-blur-md animate-float-slow lg:-left-8">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent/15 text-accent">
              <Star className="h-5 w-5 fill-accent" />
            </span>
            <div>
              <p class="font-display text-sm font-semibold">4.9 / 5</p>
              <p class="text-xs text-muted-foreground">120+ valoraciones</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats bar -->
    <div class="relative border-t border-border bg-card/50 backdrop-blur-sm">
      <dl class="mx-auto grid max-w-7xl grid-cols-2 gap-px overflow-hidden border-x border-border md:grid-cols-4 lg:px-8">
        {stats.map((s) => (
          <div class="group bg-background/40 px-6 py-8 text-center transition-colors hover:bg-card">
            <dt class="font-display text-3xl font-semibold text-primary transition-transform group-hover:scale-110 md:text-4xl">{s.value}</dt>
            <dd class="mt-1.5 text-xs font-medium uppercase tracking-wide text-muted-foreground">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Categorías -->
  <section id="categorias" class="mx-auto max-w-7xl scroll-mt-24 px-5 py-20 lg:px-8 lg:py-28">
    <div class="max-w-2xl">
      <span class="section-label"><Layers className="h-3.5 w-3.5" /> Categorías</span>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-balance lg:text-4xl">
        Explora por tipo de trabajo
      </h2>
      <p class="mt-3 text-base text-muted-foreground text-pretty">
        Desde utensilios de cocina hasta muebles a medida. Filtra el catálogo según lo que buscas.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      <a href="#catalogo" data-category="all" class="filter-cat group flex flex-col items-center gap-3 rounded-2xl border border-border bg-card p-5 text-center shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-lift">
        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary transition-colors group-hover:bg-primary group-hover:text-primary-foreground">
          <Hammer className="h-6 w-6" strokeWidth={2} />
        </span>
        <div>
          <span class="block font-display text-sm font-semibold">Todo</span>
          <span class="mt-0.5 block text-xs text-muted-foreground">{products.length} productos</span>
        </div>
      </a>
      {categories.map((c) => {
        const Icon = categoryIcons[c.id] ?? Sparkles;
        const count = products.filter((p) => p.category === c.id).length;
        return (
          <a href="#catalogo" data-category={c.id} class="filter-cat group flex flex-col items-center gap-3 rounded-2xl border border-border bg-card p-5 text-center shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-lift">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary transition-colors group-hover:bg-primary group-hover:text-primary-foreground">
              <Icon className="h-6 w-6" strokeWidth={2} />
            </span>
            <div>
              <span class="block font-display text-sm font-semibold">{c.label}</span>
              <span class="mt-0.5 block text-xs text-muted-foreground">{count}</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Catálogo -->
  <section id="catalogo" class="scroll-mt-20 border-y border-border bg-secondary/30">
    <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <span class="section-label"><Boxes className="h-3.5 w-3.5" /> Catálogo</span>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-balance lg:text-4xl">
            Productos disponibles para encargo
          </h2>
          <p class="mt-3 text-base text-muted-foreground text-pretty">
            Precios orientativos, sin pago online. Cada pieza se fabrica bajo pedido.
          </p>
        </div>
        <div class="flex items-center gap-2.5">
          <label for="filter" class="text-sm font-medium text-muted-foreground">Filtrar:</label>
          <select id="filter" class="rounded-lg border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground shadow-sm outline-none transition-all focus:border-primary focus:ring-2 focus:ring-ring">
            <option value="all">Todos</option>
            {categories.map((c) => (
              <option value={c.id}>{c.label}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Filter chips (alternative to select) -->
      <div class="mt-6 flex flex-wrap gap-2">
        <button class="filter-chip chip border border-border bg-card text-muted-foreground hover:border-primary hover:text-foreground" data-filter="all">Todos</button>
        {categories.map((c) => (
          <button class="filter-chip chip border border-border bg-card text-muted-foreground hover:border-primary hover:text-foreground" data-filter={c.id}>{c.label}</button>
        ))}
      </div>

      <div id="grid" class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((p) => (
          <div class="product-item animate-fade-up" data-category={p.category}>
            <ProductCard product={p} />
          </div>
        ))}
      </div>

      <p id="no-results" class="mt-12 hidden text-center text-sm text-muted-foreground">
        No hay productos en esta categoría.
      </p>
    </div>
  </section>

  <!-- Proceso -->
  <section id="proceso" class="mx-auto max-w-7xl scroll-mt-24 px-5 py-20 lg:px-8 lg:py-28">
    <div class="text-center">
      <span class="section-label justify-center"><Cpu className="h-3.5 w-3.5" /> Proceso</span>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-balance lg:text-4xl">Cómo trabajamos</h2>
      <p class="mx-auto mt-3 max-w-xl text-base text-muted-foreground text-pretty">
        Cuatro pasos desde tu idea hasta la pieza acabada, con comunicación en cada etapa.
      </p>
    </div>

    <div class="relative mt-14">
      <!-- Connecting line -->
      <div class="absolute left-0 right-0 top-10 hidden h-px bg-gradient-to-r from-transparent via-border to-transparent md:block"></div>
      <div class="grid gap-8 md:grid-cols-4">
        {process.map((step, i) => (
          <div class="relative group">
            <div class="relative z-10 mx-auto flex h-20 w-20 items-center justify-center rounded-2xl border border-border bg-card shadow-soft transition-all duration-300 group-hover:border-accent/40 group-hover:shadow-lift md:mx-0">
              <step.icon className="h-7 w-7 text-primary" strokeWidth={1.8} />
              <span class="absolute -right-2 -top-2 flex h-7 w-7 items-center justify-center rounded-full bg-accent font-display text-xs font-bold text-accent-foreground shadow-md">0{i + 1}</span>
            </div>
            <div class="mt-5 text-center md:text-left">
              <h3 class="font-display text-lg font-semibold">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground text-pretty">{step.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Taller / Capacidades -->
  <section id="taller" class="scroll-mt-24 border-y border-border bg-card">
    <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
      <div class="grid gap-12 lg:grid-cols-[0.85fr_1fr] lg:gap-16">
        <!-- Left: visual + statement -->
        <div class="relative overflow-hidden rounded-2xl bg-primary p-8 shadow-lift lg:p-12">
          <div class="absolute inset-0 wood-grain-dark opacity-60"></div>
          <div class="absolute inset-0 bg-gradient-to-br from-primary/95 via-primary to-accent/80"></div>
          <div class="relative flex h-full flex-col justify-between text-primary-foreground">
            <Ruler className="h-10 w-10 opacity-70" strokeWidth={1.6} />
            <div class="mt-8">
              <h2 class="font-display text-2xl font-semibold leading-tight text-balance lg:text-3xl">
                Cada pieza es única, como la madera de la que nace.
              </h2>
              <p class="mt-4 max-w-md text-sm leading-relaxed text-primary-foreground/85 text-pretty">
                Seleccionamos maderas locales de grano fino, las secamos y estabilizamos antes
                del mecanizado. Si tienes una madera propia, la fresamos por ti.
              </p>
              <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
                <span class="inline-flex items-center gap-2"><Leaf className="h-4 w-4" /> Maderas sostenibles</span>
                <span class="inline-flex items-center gap-2"><Clock className="h-4 w-4" /> Plazos claros</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: capabilities grid -->
        <div>
          <span class="section-label"><TreePine className="h-3.5 w-3.5" /> Taller</span>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-balance lg:text-4xl">
            ¿Por qué elegir nuestro CNC?
          </h2>
          <p class="mt-3 text-base text-muted-foreground text-pretty">
            El fresado CNC permite repetir patrones con precisión micrométrica,
            pero la pieza final la terminamos a mano: lijado progresivo, aceites y ceras
            que protegen la madera sin ocultar su veta.
          </p>

          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {capabilities.map((cap) => (
              <div class="group rounded-xl border border-border bg-background/50 p-5 transition-all duration-300 hover:border-accent/30 hover:shadow-soft">
                <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary transition-colors group-hover:bg-accent/15 group-hover:text-accent">
                  <cap.icon className="h-5 w-5" strokeWidth={2} />
                </span>
                <h3 class="mt-3.5 font-display text-sm font-semibold">{cap.title}</h3>
                <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground text-pretty">{cap.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Opiniones -->
  <section id="opiniones" class="mx-auto max-w-7xl scroll-mt-24 px-5 py-20 lg:px-8 lg:py-28">
    <div class="text-center">
      <span class="section-label justify-center"><Quote className="h-3.5 w-3.5" /> Opiniones</span>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-balance lg:text-4xl">Lo que dicen nuestros clientes</h2>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {testimonials.map((t) => (
        <figure class="relative flex flex-col rounded-2xl border border-border bg-card p-6 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-lift">
          <div class="flex gap-0.5 text-accent">
            {Array.from({ length: 5 }).map(() => <Star className="h-4 w-4 fill-accent" />)}
          </div>
          <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-foreground/90 text-pretty">"{t.text}"</blockquote>
          <figcaption class="mt-5 flex items-center gap-3 border-t border-border pt-4">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10 font-display text-sm font-semibold text-primary">
              {t.name.charAt(0)}
            </span>
            <div>
              <p class="text-sm font-semibold">{t.name}</p>
              <p class="text-xs text-muted-foreground">{t.role}</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- CTA / Contacto -->
  <section id="contacto" class="scroll-mt-20 border-t border-border bg-primary">
    <div class="absolute inset-0 wood-grain-dark opacity-50"></div>
    <div class="relative mx-auto max-w-5xl px-5 py-20 text-center lg:px-8 lg:py-28">
      <span class="section-label justify-center text-primary-foreground/80"><Sparkles className="h-3.5 w-3.5" /> Contacto</span>
      <h2 class="mx-auto mt-4 max-w-2xl font-display text-3xl font-semibold leading-tight text-primary-foreground text-balance lg:text-5xl">
        Pide tu presupuesto sin compromiso
      </h2>
      <p class="mx-auto mt-4 max-w-lg text-base text-primary-foreground/80 text-pretty">
        Sin registro y sin pago online. Cuéntanos qué necesitas y te respondemos en 48 horas
        con un presupuesto detallado.
      </p>

      <div class="mt-10 grid gap-4 sm:grid-cols-3">
        <a href="tel:+34600000000" class="group flex flex-col items-center gap-3 rounded-2xl border border-primary-foreground/15 bg-primary-foreground/5 p-6 backdrop-blur-sm transition-all duration-300 hover:border-primary-foreground/30 hover:bg-primary-foreground/10">
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary-foreground/10 text-primary-foreground transition-transform group-hover:scale-110">
            <Phone className="h-5 w-5" strokeWidth={2} />
          </span>
          <span class="text-sm font-semibold text-primary-foreground">Llámanos</span>
          <span class="text-xs text-primary-foreground/70">+34 600 000 000</span>
        </a>
        <a href="mailto:hola@lignare.example" class="group flex flex-col items-center gap-3 rounded-2xl border border-primary-foreground/15 bg-primary-foreground/5 p-6 backdrop-blur-sm transition-all duration-300 hover:border-primary-foreground/30 hover:bg-primary-foreground/10">
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary-foreground/10 text-primary-foreground transition-transform group-hover:scale-110">
            <Mail className="h-5 w-5" strokeWidth={2} />
          </span>
          <span class="text-sm font-semibold text-primary-foreground">Escríbenos</span>
          <span class="text-xs text-primary-foreground/70">hola@lignare.example</span>
        </a>
        <div class="group flex flex-col items-center gap-3 rounded-2xl border border-primary-foreground/15 bg-primary-foreground/5 p-6 backdrop-blur-sm">
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary-foreground/10 text-primary-foreground">
            <MapPin className="h-5 w-5" strokeWidth={2} />
